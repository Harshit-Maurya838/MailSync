# MailSync Configuration

# Nodemailer Credentials
# For Gmail, use an App Password (generated at https://myaccount.google.com/apppasswords)
# Single account:
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# Multi-Account Dynamic Failover (Zero-Database List Rotation):
# Supply comma-separated fallback accounts. If primary encounters a rate-limit (e.g. SMTP 421/452/535),
# MailSync instantly fails over to the next account in the list during the same request.
# EMAIL_USER=primary@gmail.com,backup1@gmail.com,backup2@gmail.com
# EMAIL_PASSWORD=app-pass-1,app-pass-2,app-pass-3

# Optional: Custom Sender / From Name (e.g. "Acme Corp", "MyBrand", "Support Team")
# Defaults to "MailSync" if left unset
FROM_NAME=MailSync

# Optional: Email Service provider (defaults to "gmail")
# Examples: gmail, sendgrid, mailgun, yahoo, etc.
EMAIL_SERVICE=gmail

# Optional: Full Custom From Header (overrides FROM_NAME)
# EMAIL_FROM="MyBrand <your-email@gmail.com>"

# Optional: Security Access Key to protect your /mail endpoint
# If set, clients must pass header: 'x-access-key: your-secret-key' or 'Authorization: Bearer your-secret-key'
ACCESS_KEY=your-secret-access-key

# Server Port (for local run)
PORT=5000